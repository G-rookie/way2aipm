# Local-only runtime configuration.
# Create `.env.local` from this template and keep it out of Git.

OPENAI_API_KEY=
OPENAI_MODEL=
# Optional trusted local or proxy Responses endpoint override. It receives your API key and context.
# Defaults to the official API.
# OPENAI_RESPONSES_URL=http://127.0.0.1:4362/v1/responses

# Required only when enabling external Agent Tool Adapter access.
WAY2AIPM_AGENT_TOOL_TOKEN=

# Optional local server port.
# PORT=4173
